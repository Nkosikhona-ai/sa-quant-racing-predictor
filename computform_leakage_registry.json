    "classification_rules": {
      "PRE_RACE": "Information available to bettors BEFORE today race starts. SAFE for pre-race prediction.",
      "HISTORICAL": "Information from COMPLETED past races. SAFE for feature engineering.",
      "MARKET": "Bookmaker/ComputaForm odds. Use with caution — reflects collective information.",
      "TARGET": "What we are trying to predict. NEVER use as input feature.",
      "POST_RACE_LEAKAGE": "Only known AFTER today race completes. MUST NEVER enter pre-race model.",
      "UNKNOWN": "Classification uncertain. Do not use until resolved."
    }
